# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Env / secrets — never commit keys (Adzuna / USAJOBS / OpenRouter)
.env
*.env
secrets/

# Runtime data (harvest cache, SQLite store, local shortlist) — never commit the
# box's job data. The *.db-wal / *.db-shm are SQLite's WAL sidecar files.
jobs.json
jobs.db
*.db
*.db-wal
*.db-shm
shortlist.csv

# Local session-workflow files (not part of the product)
KICKOFF-PROMPT.md
BUILD-PLAN.md
HANDOFF.md
HANDOFF-*.md
JOB-RADAR-*-BRIEF.md

# Design workshop — studies, boards, and screenshots kept local. It accumulates
# (phone screenshots, prototypes), so it is deny-by-default rather than per-file.
/design

# Editors / IDEs
.idea/
.vscode/

# OS
.DS_Store

# ── private lab: never published ──────────────────────────────────────────
# Retrieval experiments, the before/after harness, frozen corpus copies, and the
# personal search configs they run on. This repo is PUBLIC; nothing in here is
# meant to be. One line, whole tree, no exceptions to get wrong.
_private/
