# jobfitr evict — the pool's OUTFLOW (the control-loop garbage collector).
# Deletes jobs unseen > 14d or posted > 60d, and enforces an LRU row cap, so the
# SQLite store reaches a bounded steady state instead of growing without limit.
# Eviction age (14d) >> the search TTL (24h): that timescale gap is the damping
# that stops a re-fetched job from thrashing in and out of the pool.
# Oneshot; fired nightly by jobfitr-evict.timer.
# Install: /etc/systemd/system/jobfitr-evict.service (done by bootstrap.sh).
#
# ONE COLLECTOR, ONE STORE — and this unit is the blue-green one now.
# It used to say "SINGLE-SLOT ONLY … use jobfitr-evict@.service instead, enabled once per
# slot", which was true while each slot owned its own jobs.db. That layout was retired
# 2026-08-17: three copies of one ~300 MB cache (4.5 GB on disk), two eviction passes, and
# the copies DIVERGED — 29,432 jobs in one slot against 24,652 in the other, so a flip
# changed the dataset rather than the code. There is now one shared store, so a second
# collector would be two processes running the same deletes over one file.
# `evict-active.sh` resolves whichever slot is production and runs its binary; the store
# path comes from JOBFITR_DB_DIR, so a SCHEMA_VERSION bump moves the collector to the new
# file with no unit edit.

[Unit]
Description=jobfitr evict (garbage-collect the stale job pool)
OnFailure=jobfitr-notify@%n.service

[Service]
Type=oneshot
User=jobfitr
Group=jobfitr
# BOUNDED, because this unit stopped being pure SQL. Eviction used to be ~4 seconds of
# DELETEs; since 2026-08-17 it first runs a liveness pass that issues up to
# JOBFITR_VERIFY_BATCH (400) HTTP HEAD requests. Each has its own 8s timeout, so a normal run
# is well under a minute — but an unbounded oneshot that does network I/O is a job that can
# hang until someone notices, and nothing here would notice.
TimeoutStartSec=30min
EnvironmentFile=/etc/jobfitr/jobfitr.env
ExecStart=/opt/jobfitr/bin/evict-active.sh

# Hardening — may write only the shared SQLite store directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/jobfitr/data
