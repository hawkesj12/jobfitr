# Fire slot %i's eviction nightly at 03:30 (with a small randomized delay so the two
# slots never land on the same second, or on top of the harvest). Persistent=true runs
# a missed eviction after downtime instead of skipping it.
# Install: /etc/systemd/system/jobfitr-evict@.timer
#   systemctl enable --now jobfitr-evict@blue.timer jobfitr-evict@green.timer

[Unit]
Description=Run slot %i's jobfitr pool eviction nightly

[Timer]
Unit=jobfitr-evict@%i.service
# AFTER the harvest (04:07), not before it. At 03:30 this ran first and removed ~5,400
# stale rows, and the harvest then put them straight back — intake has no age filter, so
# a posting older than the 60-day rule is re-imported the moment it is still on a board.
# Measured on the live pool: 5,820 rows (14%) older than the documented limit, on a store
# whose eviction was running green every night. The eviction was never broken; the ORDER
# was. 04:45 leaves ~25 min of headroom over a ~4-minute harvest plus its randomized
# delay, so a slow harvest cannot overrun into it.
OnCalendar=*-*-* 04:45:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
